{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/_matrix/push/v1/notify",
      "destination": "/api/matrix-notify"
    },
    {
      "source": "/((?!api/|_matrix/push/v1/notify$|manifest\\.json$|sw\\.js(?:\\.map)?$|icons/|public/|assets/|config\\.json$|pdf\\.worker\\.min\\.js$).*)",
      "destination": "/index.html"
    }
  ]
}
